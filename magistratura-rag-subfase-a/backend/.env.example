# Base de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=magistratura
DB_USER=magistratura
DB_PASSWORD=troca_esta_password

# JWT — gera um segredo forte (min. 32 caracteres) em producao
JWT_SECRET=troca-este-segredo-para-producao-minimo-256-bits
JWT_EXPIRATION=86400000

# Ollama (Tutor IA) — preparado para futura troca por OpenAI/Gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Biblioteca Jurídica — pasta onde os PDFs importados são guardados
BIBLIOTECA_STORAGE_PATH=./storage/documentos

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
