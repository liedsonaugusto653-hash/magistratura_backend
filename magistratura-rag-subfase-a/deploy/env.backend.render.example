# === Colar no Render → Environment ===

SPRING_PROFILES_ACTIVE=cloud
SERVER_PORT=8080

# JWT — gera com: openssl rand -base64 48
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_LONGO_ALEATORIO_MIN_32_CHARS

# Neon (painel Connection Details → host, database, user, password)
DB_HOST=ep-xxxx.region.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=sua_password_neon
DB_SSLMODE=require

# Groq (https://console.groq.com/keys)
IA_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_sua_chave
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_TIMEOUT=120

# Knowledge sem Ollama no servidor
KNOWLEDGE_VECTOR_STORE=noop
KNOWLEDGE_EMBEDDING_FAIL_SOFT=true
KNOWLEDGE_INDEXER=knowledge

# Frontend (URLs finais da Vercel — actualiza depois do deploy do front)
CORS_ALLOWED_ORIGINS=https://teu-projecto.vercel.app
FRONTEND_BASE_URL=https://teu-projecto.vercel.app

# Email em log (recuperação de password não envia SMTP real)
EMAIL_MODE=logging

BIBLIOTECA_STORAGE_PATH=/data/documentos
PIPELINE_OCR_ENABLED=false
