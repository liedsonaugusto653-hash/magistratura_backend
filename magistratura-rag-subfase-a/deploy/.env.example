# Copiar para deploy/.env antes de: docker compose -f docker-compose.prod.yml up -d --build

# --- Base de dados ---
DB_NAME=magistratura
DB_USER=magistratura
DB_PASSWORD=alterar-password-forte

# --- JWT (OBRIGATÓRIO em prod — mínimo 32 caracteres aleatórios) ---
# openssl rand -base64 48
JWT_SECRET=gerar-com-openssl-rand-base64-48

# --- URLs públicas ---
FRONTEND_BASE_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# --- IA (Ollama) ---
# Host: http://host.docker.internal:11434  |  Contentor ollama: http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

# --- Knowledge ---
KNOWLEDGE_VECTOR_STORE=noop
# KNOWLEDGE_VECTOR_STORE=pgvector

# --- Storage PDFs (dentro do contentor backend) ---
BIBLIOTECA_STORAGE_PATH=/data/documentos

# --- OCR (só se a imagem backend incluir Tesseract) ---
PIPELINE_OCR_ENABLED=true
PIPELINE_OCR_LANGUAGE=por
# PIPELINE_OCR_DATAPATH=/usr/share/tesseract-ocr/5/tessdata
PIPELINE_OCR_THREADS=4

# --- Spring ---
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
